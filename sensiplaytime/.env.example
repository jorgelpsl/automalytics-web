# Copy this file to .env.local and fill in the real values before deploying.

# WhatsApp number every "Comprar por WhatsApp" / "Agregar al carrito" /
# contact link is built from — see src/data/site.ts and src/lib/whatsapp.ts.
# Defaults to Automalytics' own number (same one used on kasu.html,
# salon.html, etc.) for this demo. Replace with SensiPlayTime's real number
# once the client has one, in international format without spaces or
# symbols (e.g. 56912345678).
NEXT_PUBLIC_WHATSAPP_NUMBER=56932954075

# Public site URL, used for SEO metadata (Open Graph, canonical).
NEXT_PUBLIC_SITE_URL=https://sensiplaytime.cl
